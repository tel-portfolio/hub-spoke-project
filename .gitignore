# ==========================
# Terraform (Infrastructure)
# ==========================
# .terraform directories (Plugins & Modules)
**/.terraform/

# State files (CRITICAL: Never commit these!)
*.tfstate
*.tfstate.*

# Variables files (Secrets live here)
*.tfvars
*.tfvars.json

# Crash logs
crash.log
crash.*.log

# CLI configuration files
.terraformrc
terraform.rc

# Ignore override files (used for local debugging)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ==========================
# Python (The Bot)
# ==========================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments (Common names)
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Unit Test / Coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# ==========================
# Docker
# ==========================
# If you use docker-compose local overrides
docker-compose.override.yml

# ==========================
# Secrets & Config
# ==========================
# Environment variables file (VERY IMPORTANT)
.env
.env.local
.env.*.local
# Allow example files so teammates know what vars they need
!.env.example

# ==========================
# Trading Bot Data
# ==========================
# You likely don't want to commit 5GB of CSV backtest data
data/
backtests/
logs/
*.log

# ==========================
# Editor & OS Junk
# ==========================
.DS_Store
.DS_Store?
._*
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/